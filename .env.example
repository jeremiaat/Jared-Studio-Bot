# Copy to .env and fill in the values. Never commit the real .env file.

# --- Required ---
# Telegram bot token from @BotFather
BOT_TOKEN=

# --- Webhook (Vercel only) ---
# Shared secret Telegram sends in the X-Telegram-Bot-Api-Secret-Token header.
# Must match the WEBHOOK_SECRET set on the hosting platform.
WEBHOOK_SECRET=

# --- Optional ---
# Channel the bot manages (bot must be an admin of it)
CHANNEL_USERNAME=Jaredrawing
CHANNEL_URL=https://t.me/Jaredrawing

# Where new orders are forwarded (numeric Telegram user/chat id)
ORDER_CONTACT_CHAT_ID=
# Telegram username shown to customers for payment/contact
ORDER_CONTACT_USERNAME=Ja_r_ed

# Creator panel access - comma separated ids and/or usernames
CREATOR_USER_ID=
CREATOR_USER_IDS=
CREATOR_USERNAMES=
